# Exclude only the massive single-header library json.hpp from stats
**/json.hpp linguist-vendored=true

# Explicitly categorize and detect all 4 languages in repository statistics
*.cpp linguist-language=C++ linguist-detectable=true
*.h linguist-language=C++ linguist-detectable=true
*.js linguist-language=JavaScript linguist-detectable=true
*.css linguist-language=CSS linguist-detectable=true
*.html linguist-language=HTML linguist-detectable=true
